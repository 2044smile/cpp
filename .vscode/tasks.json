{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ 활성 파일 빌드",
            "command": "/usr/bin/g++ -fdiagnostics-color=always \"${fileDirname}\"/*.cpp -o \"${fileDirname}/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "디버거에서 생성된 작업입니다."
        },
        {
            "type": "shell",
            "label": "C/C++: clang 활성 파일 빌드",
            "command": "mkdir -p \"${workspaceFolder}/build/obj\" && /usr/bin/clang++ -fcolor-diagnostics -fansi-escape-codes -std=c++17 -g -c \"${file}\" -o \"${workspaceFolder}/build/obj/${fileBasenameNoExtension}.o\" && /usr/bin/clang++ -g \"${workspaceFolder}/build/obj/${fileBasenameNoExtension}.o\" -o \"${fileDirname}/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "디버거에서 생성된 작업입니다."
        }
    ],
    "version": "2.0.0"
}